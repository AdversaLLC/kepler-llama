From 109c5f8940e1982e527aa4d0e0978575ac9c51de Mon Sep 17 00:00:00 2001
From: kepler <kepler@local>
Date: Mon, 26 Oct 2026 10:05:31 -0500
Subject: [PATCH 1/3] ggml-cuda: clang as CUDA compiler (drop nvcc-only flags)

---
 ggml/src/ggml-cuda/CMakeLists.txt | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-cuda/CMakeLists.txt b/ggml/src/ggml-cuda/CMakeLists.txt
index 297d9ff..a927eec 100644
--- a/ggml/src/ggml-cuda/CMakeLists.txt
+++ b/ggml/src/ggml-cuda/CMakeLists.txt
@@ -193,7 +193,12 @@ if (CUDAToolkit_FOUND)
 
     set(CUDA_CXX_FLAGS "")
 
-    set(CUDA_FLAGS -use_fast_math -extended-lambda)
+    if (CMAKE_CUDA_COMPILER_ID STREQUAL "Clang")
+        # clang as the CUDA compiler: extended lambdas are always on; map nvcc's -use_fast_math
+        set(CUDA_FLAGS -fcuda-flush-denormals-to-zero -fcuda-approx-transcendentals -ffp-contract=fast)
+    else()
+        set(CUDA_FLAGS -use_fast_math -extended-lambda)
+    endif()
 
     if (GGML_CUDA_DEBUG)
         list(APPEND CUDA_FLAGS -lineinfo)
@@ -258,7 +263,7 @@ if (CUDAToolkit_FOUND)
 
     list(JOIN   CUDA_CXX_FLAGS " " CUDA_CXX_FLAGS_JOINED)  # pass host compiler flags as a single argument
 
-    if (NOT CUDA_CXX_FLAGS_JOINED STREQUAL "")
+    if (NOT CUDA_CXX_FLAGS_JOINED STREQUAL "" AND NOT CMAKE_CUDA_COMPILER_ID STREQUAL "Clang")
         list(APPEND CUDA_FLAGS -Xcompiler ${CUDA_CXX_FLAGS_JOINED})
     endif()
 
